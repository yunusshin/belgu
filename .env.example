# Optional startup defaults; Settings in the UI can configure connections.
# The application does not load .env automatically. Export values in the
# environment of the process that starts Belgü.
BELGU_MODEL_BACKEND=llama.cpp
BELGU_MODEL_URL=http://localhost:8080/v1
# Leave empty to discover the model, or use the exact ID from your server.
BELGU_MODEL_ID=
BELGU_MODEL_TIMEOUT=300
