{
  "name": "belgu-web",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5174",
    "test:e2e": "playwright test",
    "generate:api": "../.venv/bin/python scripts/export_openapi.py && openapi-typescript openapi.json -o src/api/generated.ts && prettier --write src/api/generated.ts",
    "format": "prettier --write src e2e"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
